{
  "name": "Omnibear",
  "version": "2.3.1",
  "description": "A micropub browser extension",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint . --ext .js,.ts,.jsx,.tsx,.json,.md",
    "lint:fix": "eslint . --fix --ext .js,.ts,.jsx,.tsx,.json,.md",
    "check": "npm run format:check && npm run lint:check",
    "postinstall": "wxt prepare",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithjgrant/omnibear.git"
  },
  "keywords": [
    "micropub"
  ],
  "author": "Keith J. Grant",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/keithjgrant/omnibear/issues"
  },
  "homepage": "https://omnibear.com",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@playwright/test": "^1.57.0",
    "@preact/preset-vite": "^2.10.3",
    "@types/chrome": "^0.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.0",
    "@webext-core/fake-browser": "^2.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.1.12",
    "wxt": "^0.21.2"
  },
  "dependencies": {
    "@preact/signals": "^2.8.0",
    "microformats-parser": "^2.0.4",
    "micropub-helper": "^2.1.1",
    "preact": "^10.28.3"
  },
  "lint-staged": {
    "*.{css,yaml,yml}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,json,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
